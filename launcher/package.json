{
  "name": "mi-launcher-forge",
  "version": "0.1.9",
  "description": "VillaWolf Launcher: Minecraft Forge y actualizaciones del modpack",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "importar-curseforge": "node tools/importar-curseforge.js",
    "test": "node --test src/tests/verificar-config.js src/tests/verificar-actualizador.js tests/verificar-empaquetador-curseforge.js tests/verificar-importar-curseforge.js tests/verificar-preparacion.js tests/verificar-cuentas.cjs tests/verificar-descargas-asistidas.cjs tests/verificar-versiones-launcher.cjs tests/verificar-soporte.cjs tests/verificar-discord.cjs tests/verificar-discord-worker.cjs",
    "cuentas:servidor": "node auth-server/server.cjs",
    "cuentas:probar": "node tools/probar-cuentas.cjs",
    "cuentas:discord": "node auth-server/discord-server.cjs"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.miserver.launcher",
    "productName": "VillaWolf Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "src/*.ps1"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/tonyvillalobosmejia-netizen/champagne-vol5-modpack/releases/latest/download"
      }
    ],
    "win": {
      "artifactName": "VillaWolf.Launcher.Setup.${version}.${ext}",
      "target": "nsis",
      "icon": "src/assets/villawolf-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "license": "MIT"
}
