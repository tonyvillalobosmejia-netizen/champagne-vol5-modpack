@import url('data:text/css,');
:root{color-scheme:dark;--bg:#09090B;--panel:#141416;--line:#29292E;--muted:#A1A1AA;--text:#F4F4F5;--accent:#E11D48;--accent2:#9F1239}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,"Segoe UI",Arial,sans-serif;font-size:13px}.app-shell{display:flex;min-height:100vh}.sidebar{width:220px;flex-shrink:0;background:#0e1118;border-right:1px solid var(--line);padding:25px 17px;display:flex;flex-direction:column}.brand-mark{width:37px;height:37px;border-radius:11px;background:linear-gradient(135deg,#6b9aff,#9F1239);display:grid;place-items:center;font-size:21px;font-weight:900;color:white;box-shadow:0 7px 24px #E11D4844}.brand{font-weight:800;letter-spacing:1.5px;margin-top:13px;font-size:13px}.brand span{display:block;color:var(--muted);font-size:9px;letter-spacing:2px;margin-top:5px}.side-label,.eyebrow{font-size:9px;font-weight:800;letter-spacing:1.7px;color:#7d879b}.side-label{margin:42px 0 12px 9px}.nav{padding:12px 10px;color:#8992a5;border-radius:8px;margin-bottom:5px}.nav.active{background:#28213e;color:#d5c8ff;border:1px solid #3b315a}.soon{float:right;font-size:8px;color:#697286;margin-top:3px}.sidebar-bottom{margin-top:auto;font-size:10px;color:#7d879b;display:flex;align-items:center;gap:8px}.dot,.live-dot{width:7px;height:7px;border-radius:50%;display:inline-block;background:#8e78f8;box-shadow:0 0 10px #8e78f877}.main{padding:24px 30px 15px;max-width:1200px;width:100%;margin:auto}.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.version-pill{font-size:9px;letter-spacing:1px;color:#a7adbd;border:1px solid var(--line);padding:7px 10px;border-radius:5px}.hero{position:relative;overflow:hidden;min-height:205px;border:1px solid #30284a;border-radius:13px;background:linear-gradient(110deg,#211b35 0%,#15182a 48%,#11151f 100%);padding:29px 31px;display:flex;align-items:center}.hero-content{z-index:2;position:relative}.overline{font-size:9px;font-weight:800;letter-spacing:1.8px;color:#FB7185}.live-dot{margin-right:7px;background:#E11D48}h1{font-size:33px;letter-spacing:2px;margin:14px 0 3px;font-weight:900}.subtitle{margin:0;color:#b4a2ff;font-size:10px;letter-spacing:2.5px;font-weight:800}.description{color:#a7afc1;margin:14px 0 17px;font-size:12px}.game-tags{display:flex;gap:7px;flex-wrap:wrap}.game-tags span{border:1px solid #45405d;background:#191a2a99;border-radius:4px;padding:6px 8px;font-size:9px;color:#d6d0ec}.orb{position:absolute;border-radius:50%;filter:blur(1px);pointer-events:none}.orb-one{width:180px;height:180px;right:12%;top:10px;border:1px solid #9b80ff33;box-shadow:inset 0 0 50px #8a6cff13,0 0 80px #7553da12}.orb-two{width:110px;height:110px;right:17%;top:45px;background:radial-gradient(circle at 35% 30%,#b7a1ff88,#6d4fd522 55%,transparent 72%)}.hero-grid{position:absolute;right:0;top:0;width:45%;height:100%;opacity:.18;background-image:linear-gradient(#8b7cc522 1px,transparent 1px),linear-gradient(90deg,#8b7cc522 1px,transparent 1px);background-size:24px 24px;mask-image:linear-gradient(90deg,transparent,#000)}.action-row{display:flex;gap:11px;margin:15px 0 22px}.primary,.secondary,.outline{cursor:pointer;border-radius:7px;font-weight:800;letter-spacing:.6px;transition:.15s}.primary{display:flex;align-items:center;gap:13px;text-align:left;background:linear-gradient(110deg,#E11D48,#9F1239);color:#fff;border:0;padding:12px 19px;min-width:235px;box-shadow:0 7px 25px #9F123922}.primary:disabled{opacity:.55;cursor:not-allowed}.play-icon{font-size:20px}.primary b{display:block;font-size:12px}.primary small{display:block;font-size:9px;font-weight:500;letter-spacing:0;color:#e2d9ff;margin-top:4px}.secondary{background:#171b26;border:1px solid #303749;color:#dce0eb;padding:0 17px;font-size:10px}.secondary span{font-size:17px;margin-right:7px;color:#FB7185}.primary:not(:disabled):hover,.secondary:hover,.outline:hover{filter:brightness(1.15)}.panel{border:1px solid var(--line);border-radius:10px;background:var(--panel);padding:18px 20px}.panel-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:13px}.panel-heading h2{font-size:15px;margin:7px 0 0}.status-chip{font-size:9px;color:#a5adbd;border:1px solid #2c3443;padding:6px 8px;border-radius:4px}.status-chip .dot{width:5px;height:5px;margin-right:5px;background:#75c9a2}.install-line{display:flex;align-items:center;gap:12px;padding:13px 0;border-top:1px solid #242a36}.install-icon{width:34px;height:34px;border:1px solid #37304d;border-radius:7px;background:#211c32;color:#FB7185;display:grid;place-items:center;font-size:19px}.install-text{flex:1;min-width:0}.install-text b{font-size:11px}.install-text small{display:block;color:var(--muted);font-size:10px;margin-top:5px}.outline{background:#171b26;border:1px solid #343c4d;color:#d7dceb;padding:9px 11px;font-size:9px;white-space:nowrap}.activity{margin-top:18px}.activity-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}.text-button{background:none;border:0;color:#8c95a9;font-size:9px;cursor:pointer}.log{height:72px;overflow:auto;background:#0e1118;border:1px solid #202633;border-radius:7px;padding:9px 11px}.log-entry{display:flex;gap:11px;color:#b5bdce;font-size:10px;line-height:1.7;margin-bottom:3px}.log-time{color:#FB7185;flex-shrink:0;font-weight:800}.log-entry.error{color:#ff9b9b}.log-entry.success .log-time{color:#79d6ac}footer{display:flex;justify-content:space-between;margin-top:15px;font-size:9px;letter-spacing:.8px;color:#8992a5}.muted{color:#626c80}@media(max-width:850px){.sidebar{width:170px}.main{padding:18px}.hero{padding:22px}.action-row{flex-wrap:wrap}.secondary{min-height:45px}}
/* Banner medieval de Champagne Vol.5 */
.hero {
  background-image:
    linear-gradient(90deg, rgba(9, 9, 11, 0.96) 0%, rgba(9, 9, 11, 0.72) 48%, rgba(9, 9, 11, 0.12) 100%),
    url("./assets/novaskin-wallpaper-ironsword.jpg");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  border: 1px solid #57202D;
}
/* Efectos visuales Champagne Vol.5 */
.hero {
  position: relative;
  overflow: hidden;
  background-size: cover;
  background-position: center;
  border-radius: 16px;
  box-shadow: inset 0 0 60px rgba(225, 29, 72, 0.12);
}

button {
  transition:
    background-color 180ms ease,
    border-color 180ms ease,
    transform 180ms ease,
    box-shadow 180ms ease;
}

button:hover {
  border-color: #E11D48;
  box-shadow: 0 0 16px rgba(225, 29, 72, 0.18);
}

button:active {
  transform: scale(0.98);
}

button:focus-visible {
  outline: 2px solid #FB7185;
  outline-offset: 3px;
}